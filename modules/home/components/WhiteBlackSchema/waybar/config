{
    "modules-left": ["sway/workspaces"],
    "modules-center": ["mpris"],
    "modules-right": ["tray", "custom/powerprofile", "bluetooth", "network", "battery", "custom/mic", "pulseaudio", "clock"],
    
    "sway/workspaces": {
        "disable-scroll": false,
        "all-outputs": true,
        "format": "{name}",
        "on-scroll-up": "swaymsg workspace prev",
        "on-scroll-down": "swaymsg workspace next"
    },

    "mpris": {
      "format": "󰝚  {player_icon} {title} - {artist}",
      "format-paused": "󰏤  {player_icon} {title}",
      "player-icons": {
            "spotify": "",
            "firefox": "",
            "vlc": "󰕼",
            "default": "󰝚"
       },
       "max-length": 40,
       "tooltip": true,
       "on-click": "playerctl play-pause",
       "on-scroll-up": "playerctl next",
       "on-scroll-down": "playerctl previous"
    },

    "custom/power": {
        "format" : "⭘ ",
        "tooltip": false,
        "on-click": "wlogout -b 5",
    },

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "warp-on-scroll": false,
        "format": "{name}",
        "cursor": true,
    },

    "tray": {
        "icon-size": 20,
        "spacing": 10,
        "cursor": true,

        "ignored-apps": [
          "Wifi Networks",
          "wifi networks",
          "nm-applet",
          "NetworkManager Applet",
          "networkmanagerapplet",
        ]
    },

    "bluetooth": {
        "format": " 󰂯 ",
        "format-disabled": " 󰂲 ",
        "format-connected": " 󰂱 ",
        "on-click": "kitty bluetui",
    },

    "network": {
        "format-wifi": "  {essid}",
        "format-ethernet": "  Ethernet",
        "format-linked": "  Linked (No IP)",
        "format-disconnected": "  Disconnected",
        "tooltip": false,
	      "on-click": "kitty nmtui",
    },

    "custom/powerprofile": {
        "exec": "~/.config/waybar/scripts/power-profile-status.sh",
        "interval": 5,
        "on-click": "~/.config/waybar/scripts/power-profile.sh",
        "tooltip": true,
        "return-type": "plain"
    },

    "battery": {
        "states": {
            "good": 85,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-full": "{icon} {capacity}%",
        "format-plugged": " {capacity}%",
        "format-charging": " {capacity}%",
        "format-alt": "{icon} {capacity}%",
        "format-icons": [" ", " ", " ", " ", " "],
        "tooltip-format": "{time}",
        "cursor": false,
    },

    "custom/mic": {
        "exec": "~/.config/waybar/scripts/mic-status.sh",
        "interval": 1,
        "on-click": "~/.config/waybar/scripts/mic-toggle.sh",
        "tooltip": true
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "  {volume}%",
        "format-bluetooth": " {volume}%",
        "format-bluetooth-muted": "  {volume}%",
        "format-icons": {
            "headphone": " ",
            "headset": " ",
            "default": [" "],
        },
        "on-click": "pavucontrol",
    },

    "clock": {
        "format": "{:%a %d/%m/%Y ~ %H:%M}",
        "tooltip-format": "<span size='15000'><tt>{calendar}</tt></span>",
        "calendar": {
            "mode": "month",
            "format": {
                "months": "<span color='#F5C2E7'><b>{}</b></span>",
                "weekdays": "<span color='#89B4FA'><b>{}</b></span>",
                "days": "<span color='#CDD6F4'><b>{}</b></span>",
                "today": "<span color='#F9E2AF'><b>{}</b></span>",
            }
        },
        "on-click": "swaync-client -t -sw",
    }
}
